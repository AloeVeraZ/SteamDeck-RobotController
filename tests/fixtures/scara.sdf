<?xml version="1.0"?>
<!-- A SCARA arm in SDFormat 1.9: poses through relative_to and a //frame, an elbow axis given in the model frame
     (pointing down, so positive turns it clockwise seen from above), a quill that slides down, a tool turned 90° about
     z by a quaternion, and a screw joint whose axis is given in that turned frame. -->
<sdf version="1.9">
  <world name="cell">
    <model name="scara">
      <link name="base">
        <visual name="column">
          <pose>0 0 0.15 0 0 0</pose>
          <geometry><cylinder><radius>0.1</radius><length>0.3</length></cylinder></geometry>
          <material><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
      <link name="link1">
        <pose relative_to="__model__">0 0 0.3 0 0 0</pose>
        <visual name="arm">
          <pose degrees="true">0.2 0 0 0 90 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.4</length></cylinder></geometry>
        </visual>
      </link>
      <joint name="shoulder" type="revolute">
        <parent>base</parent>
        <child>link1</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-2.5</lower><upper>2.5</upper><velocity>3</velocity></limit></axis>
      </joint>
      <link name="link2">
        <pose relative_to="link1">0.4 0 0 0 0 0</pose>
        <visual name="arm"><pose>0.15 0 0 0 0 0</pose><geometry><box><size>0.3 0.05 0.05</size></box></geometry></visual>
      </link>
      <joint name="elbow" type="revolute">
        <parent>link1</parent>
        <child>link2</child>
        <axis><xyz expressed_in="__model__">0 0 -1</xyz><limit><lower>-2</lower><upper>2</upper></limit></axis>
      </joint>
      <frame name="quill_top" attached_to="link2"><pose>0.3 0 0.05 0 0 0</pose></frame>
      <link name="quill">
        <pose relative_to="quill_top">0 0 0 0 0 0</pose>
        <visual name="shaft"><pose>0 0 -0.1 0 0 0</pose><geometry><cylinder><radius>0.01</radius><length>0.2</length></cylinder></geometry></visual>
      </link>
      <joint name="lift" type="prismatic">
        <parent>link2</parent>
        <child>quill</child>
        <axis><xyz>0 0 -1</xyz><limit><lower>0</lower><upper>0.2</upper></limit></axis>
      </joint>
      <link name="tool">
        <pose relative_to="quill" rotation_format="quat_xyzw">0 0 -0.1 0 0 0.7071067811865476 0.7071067811865476</pose>
        <visual name="tip"><geometry><sphere><radius>0.02</radius></sphere></geometry></visual>
      </link>
      <joint name="spin" type="screw">
        <parent>quill</parent>
        <child>tool</child>
        <screw_thread_pitch>0.005</screw_thread_pitch>
        <axis><xyz>1 0 0</xyz></axis>
      </joint>
    </model>
    <model name="table"><static>true</static><link name="top"/></model>
  </world>
</sdf>
